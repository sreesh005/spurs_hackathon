# Copy to .env and fill in. Never commit .env.

SCOREPLAY_API_KEY=
SCOREPLAY_BASE_URL=https://media.scoreplay.io/v1
# Our hackathon company (spurs2-hack-16), a clone of 5167. Confirmed in M0.
SCOREPLAY_COMPANY_ID=5370
# Our copy of Man Utd vs Spurs full match; the live feed replays its source (5167/8632559)
SCOREPLAY_MEDIA_ID=130851979
# Upload target for enriched clips: "Highlights" under Man Utd vs Tottenham - Week 6
SCOREPLAY_EVENT_ID=1536128
# Tottenham Hotspur FC 2026-27 squad (GET /team-seasons)
SCOREPLAY_TEAM_SEASON_ID=72217
# Shared secret you set as the auth header on the ScorePlay webhook
SCOREPLAY_WEBHOOK_SECRET=

TWELVELABS_API_KEY=
TWELVELABS_BASE_URL=https://api.twelvelabs.io/v1.3
# Optional until the stretch milestones
TWELVELABS_INDEX_ID=
# Our own knowledge store of delivered clips (Jockey). Created on the first DRY_RUN=false run.
TWELVELABS_STORE_ID=

# The organizer feed (HLS). Copy it from the ScorePlay info page "How to Schedule a Live feed".
LIVE_FEED_URL=
# What `pipeline live` watches: scoreplay (ScorePlay's live recording, found by itself) or feed (LIVE_FEED_URL)
LIVE_SOURCE=scoreplay

# Print writes instead of sending them
DRY_RUN=true
